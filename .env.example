APP_ENV=development

# Generate independently: openssl rand -hex 32
# REQUIRED. Never commit a populated value or reuse the example as a secret.
JWT_SECRET_KEY=

BACKEND_PORT=8000
NGINX_PORT=8080

POSTGRES_DB=honeyshield_dev
POSTGRES_USER=honeyshield
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PORT=6379

# Phase 11 — CORS Policy Settings (F-014)
# Comma-separated list of allowed origins. Wildcard '*' is strictly forbidden.
# Example: https://app.honeyshield.test,https://admin.honeyshield.test
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Request-ID
CORS_EXPOSE_HEADERS=X-Request-ID,X-Process-Time-Ms,Retry-After
CORS_MAX_AGE=600

# Phase 10 — Security Headers Hardening (F-015)
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_HEADERS_X_FRAME_OPTIONS=DENY
SECURITY_HEADERS_REFERRER_POLICY=no-referrer
SECURITY_HEADERS_CSP=default-src 'none'; frame-ancestors 'none'
SECURITY_HEADERS_PERMISSIONS_POLICY=accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
SECURITY_HEADERS_CACHE_CONTROL=no-store
SECURITY_HEADERS_HSTS_ENABLED=false
SECURITY_HEADERS_HSTS_MAX_AGE=31536000
SECURITY_HEADERS_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HEADERS_HSTS_PRELOAD=false
